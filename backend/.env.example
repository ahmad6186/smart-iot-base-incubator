BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Use one of these Firebase Admin credential options. Do not commit the JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# FIREBASE_CREDENTIALS_PATH=/absolute/path/to/firebase-service-account.json

# Optional: comma-separated emails that should become Admin when their profile is first created.
BACKEND_BOOTSTRAP_ADMIN_EMAILS=

# Existing Flask/OpenCV detection service.
DETECTION_SERVICE_URL=http://localhost:5000/status
DETECTION_SERVICE_TIMEOUT_SECONDS=3
